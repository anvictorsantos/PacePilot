{
  "name": "pacepilot-client",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:maplibre && vite",
    "build": "npm run prepare:maplibre && vite build && node scripts/check-bundle-size.mjs",
    "prepare:maplibre": "node scripts/copy-maplibre.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "cd .. && husky .husky",
    "lint:staged": "lint-staged",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "perf": "npm run build && node scripts/perf-audit.mjs",
    "perf:e2e": "PERF=1 playwright test tests/e2e/perf.spec.ts"
  },
  "dependencies": {
    "@sentry/vue": "^11.10.0",
    "axios": "^1.21.0",
    "chart.js": "^4.6.1",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.0",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.6.0",
    "maplibre-gl": "^6.16.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.14"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
