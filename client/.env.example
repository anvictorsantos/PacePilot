VITE_SENTRY_DSN=https://public-key@example.ingest.de.sentry.io/project-id
# Local development. Production is set to `production` by Render.
VITE_SENTRY_ENV=development
# Set to `true` so local dev actually reports to the development environment.
VITE_SENTRY_FORCE=true
# Production sets this to the GitHub release tag (for example `v1.2.3`).
VITE_SENTRY_RELEASE=
VITE_SENTRY_DEBUG=false
VITE_SENTRY_REPLAY_ENABLED=false
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
VITE_SENTRY_IGNORE_ERRORS=ResizeObserver loop limit exceeded,Non-Error promise rejection captured

# Google Analytics (GA4). Empty measurement id = no tag, no hits, consent banner still asks.
VITE_GA4_MEASUREMENT_ID=
# GA4 DebugView. Defaults to on in development when unset.
VITE_ANALYTICS_DEBUG=
