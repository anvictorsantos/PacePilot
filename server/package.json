{
  "name": "pacepilot-server",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --import ./scripts/register-alias.mjs --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --import ./scripts/register-alias.mjs --disable-warning=ExperimentalWarning src/index.ts",
    "test": "node --import ./scripts/register-alias.mjs --disable-warning=ExperimentalWarning --test 'tests/unit/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "echo 'server needs no build: Node type-strips src/*.ts directly (Node >=22.18)'",
    "verify:ai": "node --import ./scripts/register-alias.mjs --disable-warning=ExperimentalWarning scripts/verify-ai.mjs",
    "db:indexes": "node --disable-warning=ExperimentalWarning scripts/ensure-indexes.mjs",
    "db:migrate-providers": "node --import ./scripts/register-alias.mjs --disable-warning=ExperimentalWarning scripts/migrate-providers.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "serverless-http": "^3.2.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8",
    "body-parser": "^1.20.9"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
