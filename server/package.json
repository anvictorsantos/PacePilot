{
  "name": "pacepilot-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "test": "node --test 'tests/unit/**/*.test.ts'",
    "typecheck": "sh -c \"test -f tsconfig.json && tsc --noEmit || echo 'no tsconfig yet (JS phase) \u2014 skipping'\"",
    "build": "echo 'server needs no build (plain JS)'",
    "verify:ai": "node --disable-warning=ExperimentalWarning scripts/verify-ai.mjs",
    "db:indexes": "node --disable-warning=ExperimentalWarning scripts/ensure-indexes.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "serverless-http": "^3.2.0",
    "zod": "^3.23.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8"
  }
}
