{
  "name": "pacepilot-server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "node --test 'tests/unit/**/*.test.js' && node --test 'tests/unit/**/*.test.ts' && node --test 'tests/integration/http.test.js' && MONGODB_URI_TEST=$MONGODB_URI_TEST node --test 'tests/integration/db.test.js'",
    "typecheck": "sh -c \"test -f tsconfig.json && tsc --noEmit || echo 'no tsconfig yet (JS phase) — skipping'\"",
    "build": "echo 'server needs no build (plain JS)'"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "serverless-http": "^3.2.0",
    "zod": "^3.23.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8"
  }
}
