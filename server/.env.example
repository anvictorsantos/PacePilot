PORT=3000
MONGODB_URI=mongodb://localhost:27017/pacepilot
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
# 64-hex key for provider token-at-rest encryption (gen: openssl rand -hex 32).
# Unset = plaintext storage with startup warning. Set before prod deploy.
TOKEN_ENCRYPTION_KEY=

# Providers enabled for this deployment, comma-separated (strava, garmin).
PROVIDERS_ENABLED=strava
# Capacity counts live connections; STRAVA_ATHLETE_LIMIT is accepted as a legacy alias.
ATHLETE_LIMIT=10

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/providers/strava/callback
# Strava push subscription (GET/POST /api/providers/strava/webhook).
# One token per environment; the value Strava echoes in the subscription handshake.
# Unset = the endpoint answers 503 and the 15-minute pull remains the only import.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Returned by `npm run webhook:strava -- subscribe`; deliveries for any other
# subscription id are refused with 401.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Optional. Defaults to <APP_URL>/api/providers/strava/webhook (first CLIENT_URL
# entry when APP_URL is unset). Must be a public HTTPS URL on port 443.
STRAVA_WEBHOOK_CALLBACK_URL=
CLIENT_URL=http://localhost:5173 # comma-separated allowlist OK (dev,prod)
# Canonical host used for browser redirects (OAuth results, AI payloads,
# verification and password-reset links).
# Optional: defaults to the FIRST entry of CLIENT_URL. Set it when the
# canonical host is not first in the allowlist (e.g. www allowed, apex canonical).
APP_URL=

# Transactional email — Resend free tier (3,000/month, 100/day).
# Get a key at https://resend.com/api-keys. Development logs emails when empty.
# pacepilot.pt must be verified in Resend (SPF + DKIM) before real users.
RESEND_API_KEY=
EMAIL_FROM="PacePilot <no-reply@pacepilot.pt>"
EMAIL_REPLY_TO=
EMAIL_ENABLED=true

# Sentry tunnel validation
SENTRY_INGEST_HOST=
SENTRY_PROJECT_ID=

# OpenCode Console — pay-as-you-go credits (https://opencode.ai/console).
# Get a key under Account › Personal API keys; use Models › Request only.
OPENCODE_ENABLED=true
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# Ids ending in "-free" cost nothing; any other id bills per token, so production
# refuses to boot unless OPENCODE_ALLOW_PAID=true.
# The two models run on DIFFERENT upstreams, otherwise one outage fails both.
# Verify at GET https://opencode.ai/inference/v1/models (cost.text.input.price).
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_FALLBACK_MODEL=glm-5.3-flash
OPENCODE_ALLOW_PAID=true
OPENCODE_TIMEOUT_MS=20000
OPENCODE_TEMPERATURE=0.4
OPENCODE_MAX_TOKENS=1200
# Several models are reasoning models; thinking consumes MAX_TOKENS and can return
# an empty completion. Unset keeps the provider default; set low if completions
# come back empty.
OPENCODE_REASONING_EFFORT=
# Bounded retry on transient failures only (429/5xx/network).
OPENCODE_MAX_RETRIES=1
OPENCODE_RETRY_BASE_MS=400
# Per-athlete-week AI result cache. Primary cost control — raise it to spend less.
AI_CACHE_TTL_MS=21600000
# Render Workflows dispatcher. Empty disables the durable history import and
# leaves the existing client-driven backfill in place.
RENDER_API_KEY=
WORKFLOW_SERVICE_SLUG=pacepilot-workflows
