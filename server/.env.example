PORT=3000
MONGODB_URI=mongodb://localhost:27017/pacepilot
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
# 64-hex key for Strava token-at-rest encryption (gen: openssl rand -hex 32).
# Unset = plaintext storage with startup warning. Set before prod deploy.
TOKEN_ENCRYPTION_KEY=

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
CLIENT_URL=http://localhost:5173 # comma-separated allowlist OK (dev,prod)
# Canonical host used for browser redirects (OAuth results, AI payloads).
# Optional: defaults to the FIRST entry of CLIENT_URL. Set it when the
# canonical host is not first in the allowlist (e.g. www allowed, apex canonical).
APP_URL=

# Sentry tunnel validation
SENTRY_INGEST_HOST=
SENTRY_PROJECT_ID=

# OpenRouter — free tier only. No paid fallback exists anywhere in this project.
# Get a key at https://openrouter.ai/keys (free account, no card required).
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Both ids MUST end in ":free" — the server refuses to boot in production otherwise.
# They must also be run by DIFFERENT upstream providers, otherwise one saturated
# free pool fails both and the fallback buys you nothing.
# Verify the current free list at https://openrouter.ai/models?fmt=cards, or call
# GET /api/v1/models. GET /api/plan/ai/status reports whether this id is still free.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODEL=xingchen-agi/xing4.0-29b-a4b:free
OPENROUTER_TIMEOUT_MS=20000
OPENROUTER_TEMPERATURE=0.4
OPENROUTER_MAX_TOKENS=700
# Reasoning-model thinking budget. Several free models are reasoning models; if
# their thinking is left unbounded it consumes MAX_TOKENS and returns an empty
# completion. 0 = disable thinking (fastest, cheapest, usually best here).
OPENROUTER_REASONING_MAX_TOKENS=0
# Bounded retry on transient failures only (429/5xx/network). Keep low — the free
# tier allows only 50 requests/day per account below 10 credits purchased.
OPENROUTER_MAX_RETRIES=1
OPENROUTER_RETRY_BASE_MS=400
# Per-athlete-week AI result cache. Primary cost control — raise it to spend less.
AI_CACHE_TTL_MS=21600000
